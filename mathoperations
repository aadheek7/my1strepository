<!DOCTYPE html>
<html>
<head>
<title>Math operations</title>
</head>
<body>
<input type="number" id="num" min="1" max="100">
<button onclick="calc()">submit</button>
<p id="res"></p>
<script>
function calc(){
let n=Number(num.value);
res.innerText=(n>=1 && n <=100)?
Square: ${n**2}, Cube:${n**3}, Root:    ${Math.sqrt(n).toFixed(2)}:
"enter 1-100";
}
</script>
</body>
</html>
