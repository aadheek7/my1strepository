<!DOCTYPE html>
<html>
    <head>
        <title>Math Operations</title>
    </head>
    <body>
        <input type = 'number' id = 'num' min = '1' max = '100'>
        <button onClick = 'calc()'>Submit</button>
        <p id = 'output'></p>

        <script>
            function calc(){
                let number = Number(document.getElementById('num').value)
                let output = document.getElementById('output')

                if(number >= 1 && number <= 100){
                    output.innerText = `Square: ${number ** 2}, Cube: ${number ** 3} Square Root: ${number ** 0.5}`
                }
                else{
                    output.innerText = 'please enter a number between 1 and 100'
                }
            }
        </script>
    </body>
</html>
